{
  "name": "react-pokedex",
  "private": true,
  "version": "1.0.0",
  "description": "A Pokedex single-page app built with React, React Router and Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{js,jsx,css}\"",
    "ci": "npm run format:check && npm run lint && npm run test:ci && npm run build"
  },
  "keywords": [
    "pokedex",
    "pokemon",
    "react",
    "vite",
    "tailwindcss"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.14.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.2.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
